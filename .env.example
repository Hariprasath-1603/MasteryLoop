# MasteryLoop Environment Configuration

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=masteryloop
POSTGRES_PASSWORD=masteryloop_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=masteryloop

# Derived Database URLs
DATABASE_URL_ASYNC=postgresql+asyncpg://masteryloop:masteryloop_secret@localhost:5432/masteryloop
DATABASE_URL_SYNC=postgresql+psycopg://masteryloop:masteryloop_secret@localhost:5432/masteryloop

# Redis Configuration (AOF Enabled)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector DB Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# MLflow Tracking Server
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000

# Security & JWT
JWT_SECRET_KEY=dev_secret_key_change_in_production_min32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
